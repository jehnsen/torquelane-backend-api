# TorqueLane API environment.
#
# Defaults below are for local development against docker-compose.yml.
# docs/deploy.md lists the values staging needs. Never commit a real .env.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Shown in logs and mail.
APP_NAME=TorqueLane
# local | testing | staging | production. Anything but local/testing blocks
# destructive commands (migrate:fresh, db:wipe).
APP_ENV=local
# Generated by `composer setup` (php artisan key:generate). Encrypts
# cookies and encrypted casts; rotating it makes existing ciphertext unreadable.
APP_KEY=
# true adds the exception class, message and location to 500 responses'
# `details`. Must be false on any server reachable from the internet.
APP_DEBUG=true
# Canonical base URL of this API, no trailing slash. Used for generated links.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# file: `php artisan down` writes a file in storage/. Fine for a single server.
APP_MAINTENANCE_DRIVER=file

# Password hashing cost. Tests override to 4.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging. Every record carries `request_id` (X-Request-Id) via Laravel Context.
# ---------------------------------------------------------------------------

# stack → the channels in LOG_STACK. `daily` rotates files under storage/logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | notice | warning | error. Use info or warning on staging.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database: PostgreSQL only.
# ---------------------------------------------------------------------------

DB_CONNECTION=pgsql
# docker-compose.yml publishes Postgres on 54320 to avoid a host install on 5432.
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=torquelane
DB_USERNAME=torquelane
DB_PASSWORD=torquelane
# The API's own schema. Created automatically before any migrate command.
# Never `public`: on a shared Supabase project that schema belongs to others.
DB_SCHEMA=torquelane
# disable | prefer | require | verify-full. Use require (or verify-full) for
# any database not on localhost, Supabase included.
DB_SSLMODE=prefer
# Alternative to the five fields above: a full postgres:// URL. Leave empty to use them.
DB_URL=

# ---------------------------------------------------------------------------
# Sessions, cache, queue: all on Postgres, so the only server dependency is
# the database.
# ---------------------------------------------------------------------------

# The API authenticates with Sanctum tokens; sessions exist only for the
# framework and future SPA cookie auth.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie-based SPA auth (Sanctum). The SPA lives at app.{APP_DOMAIN}; the
# session cookie must be readable there, so on a server set SESSION_DOMAIN to
# .{APP_DOMAIN} and SESSION_SECURE_COOKIE=true. Locally the SPA is the Next.js
# dev server on localhost:3000, allowed automatically in local and testing.
#
# The product domain, e.g. torquelane.ph. Unset locally.
APP_DOMAIN=
# Where links in emails (invitations, password resets) point. Defaults to
# https://app.{APP_DOMAIN}, or http://localhost:3000 without APP_DOMAIN.
FRONTEND_URL=
# Hosts that get cookie sessions, comma-separated (host[:port], no scheme).
# Default: app.{APP_DOMAIN}, plus localhost:3000 in local and testing.
SANCTUM_STATEFUL_DOMAINS=
# Origins allowed to call the API with credentials, comma-separated (with
# scheme). Default: https://app.{APP_DOMAIN}, plus http://localhost:3000 in
# local and testing.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# database: jobs live in the `jobs` table; a supervisor-managed
# `queue:work` drains them. Tests force `sync`.
QUEUE_CONNECTION=database

# database: the `cache` table. Also holds the queue heartbeat read by
# /api/v1/health, so it must be shared by web and worker processes.
CACHE_STORE=database
CACHE_PREFIX=torquelane-cache-

# ---------------------------------------------------------------------------
# Mail. Local: Mailpit from docker-compose.yml, inbox at http://localhost:8025
# ---------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@torquelane.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# docker-compose.yml only (not read by Laravel)
# ---------------------------------------------------------------------------

# Match the server's major version: `select version();` on DB_HOST.
POSTGRES_VERSION=17
FORWARD_DB_PORT=54320
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
